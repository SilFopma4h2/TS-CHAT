# DuoChat backend
# Copy to .env and adjust for your environment. Never commit real secrets.

# Port the HTTP server listens on (also serves the /ws WebSocket endpoint).
PORT=3000

# development | production | test
NODE_ENV=development

# PostgreSQL connection string.
# Example below is for a local development database; replace with your own.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://duochat:duochat@localhost:5432/duochat