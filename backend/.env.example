# DuoChat backend
# Copy to .env and adjust for your environment. Never commit real secrets.

# Port the HTTP server listens on (also serves the /ws WebSocket endpoint).
PORT=3000

# development | production | test
NODE_ENV=development

# PostgreSQL connection string.
# Example below is for a local development database; replace with your own.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://duochat:duochat@localhost:5432/duochat

# JWT signing secret — MUST be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# Token lifetime (ms format, e.g. 7d, 12h, 3600).
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12