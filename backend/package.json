{
  "name": "duochat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DuoChat realtime chat backend (REST + WebSockets ready)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
